VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side only, used by the /api routes (api/comparison-report.js,
# api/content-ideas.js). Do NOT prefix with VITE_ — that would bundle it
# into client-side code and expose it in the browser. Set this in your
# Vercel project's Environment Variables for deployment.
ANTHROPIC_API_KEY=your-anthropic-api-key
